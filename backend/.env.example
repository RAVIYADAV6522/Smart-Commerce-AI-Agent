# Copy to .env and adjust. Never commit .env.

# API (many hosts set PORT automatically)
PORT=3000

# Session cookies (per-tab/browser cart + conversation in session)
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production
# Set to 1 when the API is served over HTTPS
# SESSION_COOKIE_SECURE=1

# Deploy: comma-separated frontend URLs (https://...)
# CORS_ORIGINS=https://my-app.vercel.app

# Request limits
# MAX_QUERY_LENGTH=4000
# ASK_RATE_LIMIT_MAX=60

# Ollama (default stack)
OLLAMA_MODEL=llama3.2
# Same machine as Node: localhost. Cloud APIs cannot use your laptop’s localhost; point this at a reachable host.
OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_JSON_FORMAT=1
OLLAMA_TEMPERATURE=0.15
OLLAMA_NUM_PREDICT=120
OLLAMA_NUM_CTX=2048

# Agent loop & fast path
MAX_AGENT_ITERATIONS=5
AGENT_FAST_PATH=1

# Optional: if you use OpenAI instead of Ollama
# OPENAI_API_KEY=
