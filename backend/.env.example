# Copy to .env and adjust. Never commit .env.

# API (many hosts set PORT automatically)
PORT=3000

# Deploy: comma-separated frontend URLs (https://...)
# CORS_ORIGINS=https://my-app.vercel.app

# Ollama (default stack)
OLLAMA_MODEL=llama3.2
# Same machine as Node: localhost. Remote Ollama: https://host:11434/api/generate (if exposed)
OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_JSON_FORMAT=1
OLLAMA_TEMPERATURE=0.15
OLLAMA_NUM_PREDICT=120
OLLAMA_NUM_CTX=2048

# Agent loop & fast path
MAX_AGENT_ITERATIONS=5
AGENT_FAST_PATH=1

# Optional: if you use OpenAI instead of Ollama
# OPENAI_API_KEY=
